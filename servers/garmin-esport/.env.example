# Salin file ini menjadi .env lalu isi nilainya. JANGAN di-commit ke Git.
PORT=3000

# Dari Garmin Developer Portal (setelah akses program disetujui)
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=

# Harus sama persis dengan redirect URI yang Anda daftarkan / pakai di Step 1 dan Step 2
# Contoh saat dev (pakai tunnel HTTPS): https://abcd.ngrok-free.app/garmin/callback
GARMIN_REDIRECT_URI=http://localhost:3000/garmin/callback

# Kunci enkripsi token (64 karakter hex). Buat dengan: openssl rand -hex 32
TOKEN_ENC_KEY=

# Rahasia di dalam URL webhook. Buat dengan: openssl rand -hex 16
# URL webhook yang didaftarkan: https://DOMAIN-ANDA/garmin/webhook/<WEBHOOK_SECRET>/<jenis>
WEBHOOK_SECRET=

# (Opsional) folder data lokal
# DATA_DIR=./data
