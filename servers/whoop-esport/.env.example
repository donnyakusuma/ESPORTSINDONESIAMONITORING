# Salin file ini menjadi .env lalu isi nilainya. JANGAN di-commit ke Git.
PORT=3000

# Dari WHOOP Developer Dashboard (https://developer-dashboard.whoop.com)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Harus sama persis dengan Redirect URL yang didaftarkan di Dashboard.
# Contoh saat dev (tunnel HTTPS): https://abcd.ngrok-free.app/whoop/callback
WHOOP_REDIRECT_URI=http://localhost:3000/whoop/callback

# Kunci enkripsi token (64 karakter hex). Buat dengan: openssl rand -hex 32
TOKEN_ENC_KEY=

# (Opsional) folder data lokal
# DATA_DIR=./data

# (Opsional) tarik data 30 hari ke belakang otomatis setelah atlet terhubung (default: true)
# BACKFILL_ON_CONNECT=true

# (Opsional) interval rekonsiliasi dalam jam (default 3). WHOOP menyarankan job berkala
# karena webhook bisa terlewat dan tidak ada webhook untuk strain harian (cycle).
# RECONCILE_EVERY_HOURS=1
